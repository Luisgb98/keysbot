# Copy this file to .env and fill in your values
# NEVER commit .env to git

DISCORD_TOKEN=your_bot_token_here
GUILD_ID=your_server_id_here

# App's Public Key (Dev Portal > General Information) — the Worker verifies
# Discord's request signatures with it. Set as a Worker secret too.
DISCORD_PUBLIC_KEY=

# Channel ID the bot writes its action log to (the #keysbot channel).
# Leave empty to disable logging.
LOG_CHANNEL_ID=

# Role IDs (enable Developer Mode, then right-click a role > Copy Role ID)
# Used by post_messages.py (button roles) — the same IDs go into the Worker's
# ALLOWED_ROLE_IDS var in worker/wrangler.toml, comma-separated:
ROLE_TECH=
ROLE_GAMING=
ROLE_ANIME=
ROLE_POE=
ROLE_DIABLO=
# setup_roles.py creates these four and prints their IDs:
ROLE_AION2=
ROLE_WOW=
ROLE_TWITCH=
ROLE_VIDEOS=

# Additional roles used by setup_channels.py (admin script for channel permissions):
ROLE_JEFE=
ROLE_MODERADOR=

# ── Announcements (subscribe_twitch.py) ──
# Twitch app from dev.twitch.tv — the same one keystroke.es uses. These three
# are also Worker secrets (`npx wrangler secret put <NAME>`).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# 10–100 random characters, e.g. `openssl rand -hex 32`. Twitch signs its
# webhooks with it.
TWITCH_EVENTSUB_SECRET=
# Channel login, e.g. keystrokeg
TWITCH_CHANNEL=
# The deployed Worker, e.g. https://keysbot.<subdomain>.workers.dev
WORKER_URL=
